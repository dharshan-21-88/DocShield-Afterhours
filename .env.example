# Server Port (defaults to 3000)
PORT=3000

# Configurable Frontend API Base URL for local or remote frontend integration
FRONTEND_API_BASE_URL="http://localhost:3000"

# Allowed CORS Origins (comma-separated or * for local development)
CORS_ORIGINS="*"

# Maximum PDF upload file size in bytes (10 MB default)
MAX_FILE_SIZE_BYTES=10485760

# Temporary file retention time in milliseconds (30 minutes default)
FILE_RETENTION_MS=1800000
